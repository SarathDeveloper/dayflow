<?xml version="1.0" encoding="utf-8"?>
<!--
  The sideloaded (debug) build updates itself from GitHub Releases
  (DayflowUpdatePlugin, scripts/release-android.mjs). A Play build never gets
  this permission: Play forbids apps installing their own updates.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Live reload: plain http to the dev server on localhost / 10.0.2.2 only. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
