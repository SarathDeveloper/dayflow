# Dayflow cloud sync (Supabase). Both values are public by design: they ship
# inside the app bundle, and row-level security on public.dayflow_records is
# what keeps each account's data private.
# Never put the service_role / secret key here, or anywhere in this repo.
#
# The URL is the site's own /supabase proxy (vercel.json), not
# https://ixdlvwwzqnlabzempbvl.supabase.co: some Indian networks block
# *.supabase.co by DNS, and the app requires sign-in.
VITE_SUPABASE_URL="https://dayflow-one-blue.vercel.app/supabase"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YYnfhyRdOBvI6pIQHoIs4Q_CYf1nKO7"
